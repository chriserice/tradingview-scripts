//@version=6
indicator("Beardo Pivot", overlay=true, max_lines_count=20, max_labels_count=100)

// ─────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────
grp_src = "Pivot Source"
src_type = input.string("Auto (Previous Quarter)", title="Source", options=["Auto (Previous Quarter)", "Manual"], group=grp_src)

grp_man = "Manual Inputs (when Source = Manual)"
man_high  = input.float(748.65, title="Previous Quarter High",  group=grp_man)
man_low   = input.float(571.92, title="Previous Quarter Low",   group=grp_man)
man_close = input.float(736.40, title="Previous Quarter Close", group=grp_man)

grp_style = "Style"
show_pp     = input.bool(true, title="Show Pivot Point (PP)",        group=grp_style)
show_r1     = input.bool(true, title="Show R1",                      group=grp_style)
show_r2     = input.bool(true, title="Show R2",                      group=grp_style)
show_s1     = input.bool(true, title="Show S1",                      group=grp_style)
show_s2     = input.bool(true, title="Show S2",                      group=grp_style)
show_prev_q = input.bool(true,  title="Show Previous Quarter Pivots", group=grp_style)
show_bg     = input.bool(false, title="Show Bullish/Bearish Background", group=grp_style)
show_table  = input.bool(false, title="Show Info Table",               group=grp_style)
tbl_pos     = input.string("Top Right", title="Table Position", options=["Top Right", "Bottom Right"], group=grp_style)

col_pp = input.color(color.new(color.white, 0), title="PP Color",         group=grp_style)
col_r  = input.color(color.new(color.red,   0), title="Resistance Color", group=grp_style)
col_s  = input.color(color.new(color.teal,  0), title="Support Color",    group=grp_style)
lw     = input.int(2, title="Line Width", minval=1, maxval=4,              group=grp_style)

// ─────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────
dim(color col) => color.new(col, 60)

quarter_of(int m) => math.floor((m - 1) / 3)

is_new_quarter() =>
    ta.change(quarter_of(month) + year * 4) != 0

new_quarter = is_new_quarter()

// ─────────────────────────────────────────────
// QUARTERLY OHLC VIA SECURITY
// ─────────────────────────────────────────────
// Current Q pivots use previous quarter's HLC  [1]
// Prev Q pivots use two quarters back           [2]
[q_high,  q_low,  q_close]  = request.security(syminfo.tickerid, "3M",
     [high[1], low[1], close[1]], lookahead=barmerge.lookahead_on)

[pq_high, pq_low, pq_close] = request.security(syminfo.tickerid, "3M",
     [high[2], low[2], close[2]], lookahead=barmerge.lookahead_on)

use_high  = src_type == "Manual" ? man_high  : q_high
use_low   = src_type == "Manual" ? man_low   : q_low
use_close = src_type == "Manual" ? man_close : q_close

// ─────────────────────────────────────────────
// PIVOT LEVELS
// ─────────────────────────────────────────────
// Current quarter
pp = (use_high + use_low + use_close) / 3
r1 = 2 * pp - use_low
r2 = pp + (use_high - use_low)
s1 = 2 * pp - use_high
s2 = pp - (use_high - use_low)

// Previous quarter
pq_pp = (pq_high + pq_low + pq_close) / 3
pq_r1 = 2 * pq_pp - pq_low
pq_r2 = pq_pp + (pq_high - pq_low)
pq_s1 = 2 * pq_pp - pq_high
pq_s2 = pq_pp - (pq_high - pq_low)

// ─────────────────────────────────────────────
// CHART-NATIVE QUARTER BOUNDARIES
// Track bar_index (not 3M timestamps). A 1ms time delta (t, t+1) maps to
// the SAME weekly/monthly bar, so line.new treats x1==x2 as a vertical line.
// See: https://www.tradingview.com/pine-script-docs/faq/visuals/
// ─────────────────────────────────────────────
var int cq_start_bar = bar_index
var int pq_start_bar = na

if new_quarter
    pq_start_bar := cq_start_bar
    cq_start_bar := bar_index

// ─────────────────────────────────────────────
// LINE / LABEL HANDLES
// ─────────────────────────────────────────────
var line ln_pp  = na,  var label lb_pp  = na
var line ln_r1  = na,  var label lb_r1  = na
var line ln_r2  = na,  var label lb_r2  = na
var line ln_s1  = na,  var label lb_s1  = na
var line ln_s2  = na,  var label lb_s2  = na

var line pln_pp = na,  var label plb_pp = na
var line pln_r1 = na,  var label plb_r1 = na
var line pln_r2 = na,  var label plb_r2 = na
var line pln_s1 = na,  var label plb_s1 = na
var line pln_s2 = na,  var label plb_s2 = na

// ─────────────────────────────────────────────
// DRAW FUNCTIONS  (bar-index anchored)
// x2 is always at least 1 bar after x1 so the line cannot collapse vertical.
// ─────────────────────────────────────────────
draw_cur(val, col, sty) =>
    ls = sty == "solid" ? line.style_solid : line.style_dashed
    line.new(cq_start_bar, val, bar_index + 1, val,
         color=col, width=lw, style=ls, extend=extend.right)

label_cur(val, col, lbl) =>
    label.new(cq_start_bar, val,
         text=" " + lbl + "   " + str.tostring(val, format.mintick) + " ",
         color=color.new(#111111, 10),
         textcolor=col,
         style=label.style_label_right,
         size=size.normal,
         textalign=text.align_left)

draw_prev(val, col) =>
    line.new(pq_start_bar, val, cq_start_bar, val,
         color=col, width=lw, style=line.style_dashed, extend=extend.none)

label_prev(val, col, lbl) =>
    label.new(pq_start_bar, val,
         text=" " + lbl + "   " + str.tostring(val, format.mintick) + " ",
         color=color.new(#111111, 10),
         textcolor=col,
         style=label.style_label_right,
         size=size.small,
         textalign=text.align_left)

// ─────────────────────────────────────────────
// DRAW ON LAST BAR
// ─────────────────────────────────────────────
if barstate.islast

    // — Current Quarter —
    if show_pp
        line.delete(ln_pp),   label.delete(lb_pp)
        ln_pp  := draw_cur(pp, col_pp, "solid")
        lb_pp  := label_cur(pp, col_pp, "PP")

    if show_r1
        line.delete(ln_r1),   label.delete(lb_r1)
        ln_r1  := draw_cur(r1, col_r, "solid")
        lb_r1  := label_cur(r1, col_r, "R1")

    if show_r2
        line.delete(ln_r2),   label.delete(lb_r2)
        ln_r2  := draw_cur(r2, col_r, "solid")
        lb_r2  := label_cur(r2, col_r, "R2")

    if show_s1
        line.delete(ln_s1),   label.delete(lb_s1)
        ln_s1  := draw_cur(s1, col_s, "solid")
        lb_s1  := label_cur(s1, col_s, "S1")

    if show_s2
        line.delete(ln_s2),   label.delete(lb_s2)
        ln_s2  := draw_cur(s2, col_s, "solid")
        lb_s2  := label_cur(s2, col_s, "S2")

    // — Previous Quarter —
    if show_prev_q and not na(pq_start_bar) and pq_start_bar != cq_start_bar
        line.delete(pln_pp),  label.delete(plb_pp)
        pln_pp := draw_prev(pq_pp, dim(col_pp))
        plb_pp := label_prev(pq_pp, dim(col_pp), "prev PP")

        line.delete(pln_r1),  label.delete(plb_r1)
        pln_r1 := draw_prev(pq_r1, dim(col_r))
        plb_r1 := label_prev(pq_r1, dim(col_r), "prev R1")

        line.delete(pln_r2),  label.delete(plb_r2)
        pln_r2 := draw_prev(pq_r2, dim(col_r))
        plb_r2 := label_prev(pq_r2, dim(col_r), "prev R2")

        line.delete(pln_s1),  label.delete(plb_s1)
        pln_s1 := draw_prev(pq_s1, dim(col_s))
        plb_s1 := label_prev(pq_s1, dim(col_s), "prev S1")

        line.delete(pln_s2),  label.delete(plb_s2)
        pln_s2 := draw_prev(pq_s2, dim(col_s))
        plb_s2 := label_prev(pq_s2, dim(col_s), "prev S2")

// ─────────────────────────────────────────────
// BACKGROUND SHADING  (current quarter bias)
// ─────────────────────────────────────────────
bgcolor(show_bg and close > pp ? color.new(color.teal, 93) : na, title="Bullish Background")
bgcolor(show_bg and close < pp ? color.new(color.red,  93) : na, title="Bearish Background")

// ─────────────────────────────────────────────
// INFO TABLE  (current quarter)
// ─────────────────────────────────────────────
if show_table and barstate.islast
    tbl_position = tbl_pos == "Bottom Right" ? position.bottom_right : position.top_right
    var table t = table.new(tbl_position, 3, 7,
         border_color=color.new(color.gray, 60), border_width=1,
         frame_color=color.new(color.gray, 40), frame_width=1)

    table.cell(t, 0, 0, "Beardo Pivot",
         text_color=color.white, bgcolor=color.new(color.navy, 20),
         text_halign=text.align_center, text_size=size.normal,
         text_font_family=font.family_monospace)
    table.merge_cells(t, 0, 0, 2, 0)

    table.cell(t, 0, 1, "Level", text_color=color.gray, bgcolor=color.new(color.navy, 40), text_size=size.small)
    table.cell(t, 1, 1, "Price", text_color=color.gray, bgcolor=color.new(color.navy, 40), text_size=size.small)
    table.cell(t, 2, 1, "Delta", text_color=color.gray, bgcolor=color.new(color.navy, 40), text_size=size.small)

    r2_delta = close - r2
    table.cell(t, 0, 2, "R2", text_color=col_r, bgcolor=color.new(col_r, 88), text_size=size.small)
    table.cell(t, 1, 2, str.tostring(r2, format.mintick), text_color=col_r, bgcolor=color.new(col_r, 88), text_size=size.small)
    table.cell(t, 2, 2, (r2_delta >= 0 ? "+" : "") + str.tostring(r2_delta, "#.##"), text_color=r2_delta >= 0 ? col_r : col_s, bgcolor=color.new(col_r, 88), text_size=size.small)

    r1_delta = close - r1
    table.cell(t, 0, 3, "R1", text_color=col_r, bgcolor=color.new(col_r, 88), text_size=size.small)
    table.cell(t, 1, 3, str.tostring(r1, format.mintick), text_color=col_r, bgcolor=color.new(col_r, 88), text_size=size.small)
    table.cell(t, 2, 3, (r1_delta >= 0 ? "+" : "") + str.tostring(r1_delta, "#.##"), text_color=r1_delta >= 0 ? col_r : col_s, bgcolor=color.new(col_r, 88), text_size=size.small)

    pp_delta = close - pp
    table.cell(t, 0, 4, "PP", text_color=col_pp, bgcolor=color.new(col_pp, 88), text_size=size.small)
    table.cell(t, 1, 4, str.tostring(pp, format.mintick), text_color=col_pp, bgcolor=color.new(col_pp, 88), text_size=size.small)
    table.cell(t, 2, 4, (pp_delta >= 0 ? "+" : "") + str.tostring(pp_delta, "#.##"), text_color=pp_delta >= 0 ? col_r : col_s, bgcolor=color.new(col_pp, 88), text_size=size.small)

    s1_delta = close - s1
    table.cell(t, 0, 5, "S1", text_color=col_s, bgcolor=color.new(col_s, 88), text_size=size.small)
    table.cell(t, 1, 5, str.tostring(s1, format.mintick), text_color=col_s, bgcolor=color.new(col_s, 88), text_size=size.small)
    table.cell(t, 2, 5, (s1_delta >= 0 ? "+" : "") + str.tostring(s1_delta, "#.##"), text_color=s1_delta >= 0 ? col_r : col_s, bgcolor=color.new(col_s, 88), text_size=size.small)

    s2_delta = close - s2
    table.cell(t, 0, 6, "S2", text_color=col_s, bgcolor=color.new(col_s, 88), text_size=size.small)
    table.cell(t, 1, 6, str.tostring(s2, format.mintick), text_color=col_s, bgcolor=color.new(col_s, 88), text_size=size.small)
    table.cell(t, 2, 6, (s2_delta >= 0 ? "+" : "") + str.tostring(s2_delta, "#.##"), text_color=s2_delta >= 0 ? col_r : col_s, bgcolor=color.new(col_s, 88), text_size=size.small)

// ─────────────────────────────────────────────
// DATA WINDOW PLOTS
// ─────────────────────────────────────────────
plot(pp,    title="PP",      color=col_pp,      linewidth=1, display=display.data_window)
plot(r1,    title="R1",      color=col_r,       linewidth=1, display=display.data_window)
plot(r2,    title="R2",      color=col_r,       linewidth=1, display=display.data_window)
plot(s1,    title="S1",      color=col_s,       linewidth=1, display=display.data_window)
plot(s2,    title="S2",      color=col_s,       linewidth=1, display=display.data_window)
plot(pq_pp, title="prev PP", color=dim(col_pp), linewidth=1, display=display.data_window)
plot(pq_r1, title="prev R1", color=dim(col_r),  linewidth=1, display=display.data_window)
plot(pq_r2, title="prev R2", color=dim(col_r),  linewidth=1, display=display.data_window)
plot(pq_s1, title="prev S1", color=dim(col_s),  linewidth=1, display=display.data_window)
plot(pq_s2, title="prev S2", color=dim(col_s),  linewidth=1, display=display.data_window)

// ─────────────────────────────────────────────
// ALERTS  (current quarter only)
// ─────────────────────────────────────────────
alertcondition(ta.cross(close, pp), title="Price crosses PP",
     message="{{ticker}} crossed the Quarterly Pivot Point at {{close}}")
alertcondition(ta.cross(close, r1), title="Price crosses R1",
     message="{{ticker}} crossed Quarterly R1 at {{close}}")
alertcondition(ta.cross(close, r2), title="Price crosses R2",
     message="{{ticker}} crossed Quarterly R2 at {{close}}")
alertcondition(ta.cross(close, s1), title="Price crosses S1",
     message="{{ticker}} crossed Quarterly S1 at {{close}}")
alertcondition(ta.cross(close, s2), title="Price crosses S2",
     message="{{ticker}} crossed Quarterly S2 at {{close}}")
