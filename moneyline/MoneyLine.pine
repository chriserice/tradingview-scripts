//@version=6
// =============================================================================
//  Money Line v3 (Bullmania-Style) — Chandelier/ATR trend-regime filter
//  Inspired by the "Money Line" published by Bullmania / Ivan on Tech
//  (https://bullmania.com/moneyline). The original is closed-source; this is an
//  independent reconstruction, NOT the official indicator.
//
//  WHAT CHANGED FROM v2 (all changes backtested on BTC / ASTS / SPX weekly,
//  2018-2026, long/flat regime strategy, no lookahead):
//    1. Flip cooldown (input default 3 bars; see the cooldown semantics
//       note at the input below): after a flip, opposite flips are ignored
//       for N bars. This was the single biggest win in testing: on BTC
//       weekly the binary prototype went from 67 flips (79% whipsawed) to
//       33 flips (58%). Current backtest evidence for the shipped
//       three-state mode and the current defaults is in README.md.
//    2. Three-state regime via a faster "caution band" (default 2.0x ATR):
//       RISK-ON (both lines bullish) / CAUTION (slow bullish, fast bearish)
//       / RISK-OFF (slow bearish). Maps to 1.0 / 0.5 / 0 exposure. Best
//       drawdown profile of every variant tested on all three assets.
//    3. Data-driven direction init (v2 hardcoded a bullish start).
//    4. Status table now shows distance to the flip level in ATRs and %,
//       plus bars since the last flip — the two numbers that drive sizing.
//    5. Alerts use dynamic messages carrying the flip level and distance.
//
//  WHAT WAS TESTED AND REJECTED:
//    * Confirmation bars = 2: consistently harmful (extra lag cost more than
//      the noise it removed). Kept as an input, defaults to 1 = off.
//    * Volatility-adaptive ATR multiplier: mixed-to-negative. Dropped.
//
//  HONEST LIMITS: v2 as published flips ~7-8x/year on BTC weekly, far noisier
//  than the marketed "handful of trades per year". The cooldown closes most
//  of that gap (roughly 3 to 5 flips/yr on BTC weekly depending on preset
//  and window). This is still a lagging, long-only regime filter: red means
//  step aside / raise cash, never a short signal. Validate on your own
//  assets and timeframes before sizing off it.
//
//  2026-10 SETTINGS REVIEW (full review: REVIEW.md next to this file):
//    * Default preset is now Conservative (22 / 3.5). In a 120-config sweep
//      across the current book, 22/3.5 ranked #1 under every weighting and
//      window tested; the old 22/3.0 default ranked 42/120. The 22/3.0
//      preset stays available in the list, labeled Legacy.
//    * Cooldown input default is now 3, which reproduces the backtested
//      "cooldown 4" strength exactly (semantics differ by one bar between
//      this script and the reference engine; see the input comment).
// =============================================================================

indicator("Money Line (Bullmania-Style)", shorttitle="MoneyLine", overlay=true, max_labels_count=500, max_lines_count=500)

// -----------------------------------------------------------------------------
//  INPUTS
// -----------------------------------------------------------------------------
grp_core   = "Core Methodology"
preset     = input.string("Conservative (22 / 3.5)", "Preset", options=["Conservative (22 / 3.5)", "Balanced (14 / 2.5)", "Aggressive (10 / 2.0)", "Conservative Legacy (22 / 3.0)", "Custom"], group=grp_core, tooltip="One-click parameter sets. Choose Custom to use the manual inputs below.")
atrLenCus  = input.int(22,    "ATR Length (Custom preset)",        minval=1, group=grp_core)
atrMultCus = input.float(3.0, "ATR Multiplier (Custom preset)",    minval=0.1, step=0.1, group=grp_core)
hhLenCus   = input.int(22,    "Donchian Anchor Length (Custom)",    minval=1, group=grp_core)

usePreset = preset != "Custom"
atrLen  = usePreset ? (preset == "Balanced (14 / 2.5)" ? 14 : preset == "Aggressive (10 / 2.0)" ? 10 : 22)     : atrLenCus
atrMult = usePreset ? (preset == "Balanced (14 / 2.5)" ? 2.5 : preset == "Aggressive (10 / 2.0)" ? 2.0 : preset == "Conservative Legacy (22 / 3.0)" ? 3.0 : 3.5)   : atrMultCus
hhLen   = usePreset ? (preset == "Balanced (14 / 2.5)" ? 14 : preset == "Aggressive (10 / 2.0)" ? 10 : 22)     : hhLenCus

useWicks  = input.bool(true,  "Use Wicks (High/Low) for Flip",      group=grp_core, tooltip="True: flips trigger on wick crosses (more responsive, more noise). False: close/EMA only.")
srcMA     = input.source(close, "Confirmation Source",               group=grp_core)
smoothLen = input.int(3,      "Confirmation Smoothing (EMA)",        minval=1, group=grp_core)

grp_v3     = "Noise Controls"
// Cooldown semantics (REVIEW.md finding H2): this script blocks C bars
// after a flip; the Python reference engine blocks C-1 bars for the same
// input value. So the input value 3 here reproduces exactly the strength
// the backtests validated as "cooldown 4". The logic is unchanged; only
// the default input moved from 4 to 3 to match the backtested strength.
cooldownBars = input.int(3,   "Flip Cooldown (bars)",                minval=0, group=grp_v3, tooltip="After a flip, ignore opposite flips for N bars. Default 3 = the backtested 'cooldown 4' strength (this script blocks one more bar than the reference engine for the same input; see code comment). 0 = no cooldown.")
confirmBars  = input.int(1,   "Flip Confirmation (bars)",            minval=1, group=grp_v3, tooltip="Flip requires N consecutive bars of the cross condition. Backtesting showed 2+ hurts (lag > noise saved). Leave at 1.")
useBand      = input.bool(true,"Caution Band (three-state regime)",  group=grp_v3, tooltip="Adds a faster inner line. Slow bull + fast bear = CAUTION (half risk).")
fastMult     = input.float(2.0,"Caution Band ATR Multiplier",         minval=0.5, step=0.1, group=grp_v3)

grp_visual = "Visual Style"
showZone   = input.bool(true,  "Shade Bull/Bear Zone",      group=grp_visual)
showLabels = input.bool(true,  "Show Flip Labels",          group=grp_visual)
showFlipLv = input.bool(true,  "Show Current Flip Level",   group=grp_visual)
bullColor  = input.color(color.new(#26a69a, 0), "Risk-On Color",  group=grp_visual)
cautColor  = input.color(color.new(#ffa726, 0), "Caution Color",  group=grp_visual)
bearColor  = input.color(color.new(#ef5350, 0), "Risk-Off Color", group=grp_visual)
zoneAlpha  = input.int(85,    "Zone Transparency",           minval=0, maxval=100, group=grp_visual)

grp_alert  = "Alerts"
alertOnBar = input.bool(false, "Alert intrabar (else on bar close)", group=grp_alert, tooltip="Intrabar alerts can repaint if the flip un-crosses before the close. Bar-close is recommended.")


// -----------------------------------------------------------------------------
//  CORE: Chandelier/ATR trailing-stop regime engine
//  Returns [direction, active line, bars-since-flip, bullFlip, bearFlip, atr]
// -----------------------------------------------------------------------------
f_moneyline(_high, _low, _src, _atrLen, _atrMult, _hhLen, _useWicks, _confirmBars, _cooldownBars) =>
    _atr      = ta.atr(_atrLen)
    _longRaw  = ta.highest(_high, _hhLen) - _atrMult * _atr
    _shortRaw = ta.lowest(_low,  _hhLen)  + _atrMult * _atr

    var float _longStop  = na
    var float _shortStop = na
    var int   _dir       = na
    var int   _upStreak  = 0
    var int   _dnStreak  = 0
    var int   _bsf       = na   // bars since last flip

    // One-directional latch: the stop only ratchets in the trend's favor.
    if na(_longStop)
        _longStop  := _longRaw
        _shortStop := _shortRaw
    else
        _longStop  := _src[1] > _longStop[1]  ? math.max(_longRaw,  _longStop[1])  : _longRaw
        _shortStop := _src[1] < _shortStop[1] ? math.min(_shortRaw, _shortStop[1]) : _shortRaw

    // Data-driven init: no hardcoded bullish start.
    if na(_dir) and not na(_longRaw)
        _dir := _src > _longRaw ? 1 : -1

    // Cross conditions, with optional multi-bar confirmation.
    _upRaw = _useWicks ? _high > _shortStop[1] : _src > _shortStop[1]
    _dnRaw = _useWicks ? _low  < _longStop[1]  : _src < _longStop[1]
    _upStreak := _upRaw ? nz(_upStreak[1], 0) + 1 : 0
    _dnStreak := _dnRaw ? nz(_dnStreak[1], 0) + 1 : 0
    _flipUp = _upStreak >= _confirmBars
    _flipDn = _dnStreak >= _confirmBars

    // Cooldown gate: ignore opposite flips for N bars after a flip.
    _cooled = na(_bsf) or _bsf >= _cooldownBars
    _dPrev  = nz(_dir[1], _dir)
    _bullFlip = false
    _bearFlip = false
    if _dPrev == -1 and _flipUp and _cooled
        _dir      := 1
        _bullFlip := true
    else if _dPrev == 1 and _flipDn and _cooled
        _dir      := -1
        _bearFlip := true

    if _bullFlip or _bearFlip
        _bsf := 0
    else if not na(_bsf)
        _bsf := _bsf + 1

    _line = _dir == 1 ? _longStop : _shortStop
    [_dir, _line, _bsf, _bullFlip, _bearFlip, _atr]

// Slow (primary) line + fast (caution band) line
src = ta.ema(srcMA, smoothLen)
[slowDir, slowLine, bsf, bullFlip, bearFlip, atrVal] = f_moneyline(high, low, src, atrLen, atrMult, hhLen, useWicks, confirmBars, cooldownBars)
[fastDir, fastLine, _ign1, _ign2, _ign3, _ign4]            = f_moneyline(high, low, src, atrLen, fastMult, hhLen, useWicks, confirmBars, cooldownBars)

// Three-state regime
isRiskOff = slowDir == -1
isCaution = slowDir == 1 and useBand and fastDir == -1
regimeColor = isRiskOff ? bearColor : isCaution ? cautColor : bullColor
regimeName  = isRiskOff ? "RISK-OFF" : isCaution ? "CAUTION" : "RISK-ON"

// Distance from price to the flip level: the "how much heat?" gauge
distAtr = (close - slowLine) / atrVal
distPct = (close - slowLine) / slowLine * 100

// -----------------------------------------------------------------------------
//  PLOTS
// -----------------------------------------------------------------------------
p_line = plot(slowLine, "Money Line (slow)", color=regimeColor, linewidth=2, style=plot.style_linebr)
plot(useBand ? fastLine : na, "Caution Band (fast)", color=color.new(regimeColor, 40), linewidth=1, style=plot.style_linebr)
p_px   = plot(showZone ? close : na, "Price (zone helper)", display=display.none)
fill(p_line, p_px, color=color.new(regimeColor, zoneAlpha), title="Trend Zone")
bgcolor(showZone ? color.new(regimeColor, 95) : na, title="Background")

// Slow-line flip markers
plotshape(showLabels and bullFlip, title="Bullish Flip", style=shape.labelup,   location=location.belowbar, color=bullColor, textcolor=color.white, text="bullish", size=size.tiny)
plotshape(showLabels and bearFlip, title="Bearish Flip", style=shape.labeldown, location=location.abovebar, color=bearColor, textcolor=color.white, text="bearish", size=size.tiny)

// Fast-line (caution) transitions: small triangles
fastBull = useBand and showLabels and fastDir == 1  and nz(fastDir[1], 1)  == -1
fastBear = useBand and showLabels and fastDir == -1 and nz(fastDir[1], -1) == 1
plotshape(fastBull, title="Caution Lifted", style=shape.triangleup,   location=location.belowbar, color=color.new(cautColor, 0), size=size.tiny)
plotshape(fastBear, title="Caution Flag",    style=shape.triangledown, location=location.abovebar, color=color.new(cautColor, 0), size=size.tiny)

// Current flip level label (right side)
var label flipLbl = na
if showFlipLv and barstate.islast
    label.delete(flipLbl)
    flipLbl := label.new(bar_index, slowLine, text="Flip Level: " + str.tostring(slowLine, format.mintick), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 60), textcolor=color.white, size=size.small)

// -----------------------------------------------------------------------------
//  ALERTS (dynamic messages: state + flip level + distance)
// -----------------------------------------------------------------------------
if bullFlip and (alertOnBar or barstate.isconfirmed)
    alert("Money Line flipped BULLISH (RISK-ON) on " + syminfo.ticker + " (" + timeframe.period + ") at " + str.tostring(close, format.mintick) + " | flip level " + str.tostring(slowLine, format.mintick), alert.freq_once_per_bar_close)
if bearFlip and (alertOnBar or barstate.isconfirmed)
    alert("Money Line flipped BEARISH (RISK-OFF) on " + syminfo.ticker + " (" + timeframe.period + ") at " + str.tostring(close, format.mintick) + " | flip level " + str.tostring(slowLine, format.mintick), alert.freq_once_per_bar_close)
if useBand and fastBear and (alertOnBar or barstate.isconfirmed)
    alert("Money Line CAUTION on " + syminfo.ticker + " (" + timeframe.period + "): fast band flipped bearish while slow line holds — consider half risk. Flip level " + str.tostring(slowLine, format.mintick), alert.freq_once_per_bar_close)

// -----------------------------------------------------------------------------
//  STATUS TABLE (top-right)
// -----------------------------------------------------------------------------
var table tbl = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    distTxt = str.tostring(distAtr, "#.#") + " ATR (" + (distAtr >= 0 ? "+" : "") + str.tostring(distPct, "#.#") + "%)"
    bsfTxt  = na(bsf) ? "—" : str.tostring(bsf)
    table.cell(tbl, 0, 0, "Money Line",   bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, regimeName,        bgcolor=regimeColor,                text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 1, "Flip Level",      bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(slowLine, format.mintick), bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 2, "Distance",        bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, distTxt,           bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 3, "Bars Since Flip", bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 3, bsfTxt,            bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 4, "ATR(" + str.tostring(atrLen) + ")", bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, str.tostring(atrVal, format.mintick), bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
